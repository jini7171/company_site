# 배포 도메인 (Open Graph / canonical URL 생성에 사용)
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Supabase (게시판 읽기 + 사업문의 저장). Project Settings → API의 Project URL / Publishable key
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 사업문의 알림 전달 경로 (메일·CRM·Slack Webhook 등, 선택). Supabase와 둘 다 비워두면 Production에서는 접수하지 않습니다.
INQUIRY_WEBHOOK_URL=
